# Model: baseline (default) or muril
MODEL_BACKEND=baseline
MURIL_CHECKPOINT_DIR=checkpoints/muril_lora/run1
# ML_CONFIDENCE_THRESHOLD overrides the validation-calibrated saved threshold.
# CONFIDENCE_THRESHOLD remains a backwards-compatible alias.
# Set to a value in [0,1] to override it for a deployment.
ML_CONFIDENCE_THRESHOLD=
CONFIDENCE_THRESHOLD=
BASELINE_CHECKPOINT_DIR=checkpoints/baseline
TAXONOMY_CONFIG=config/taxonomy.json
DEPARTMENTS_CONFIG=config/departments.json
THRESHOLDS_CONFIG=config/thresholds.json
SLA_CONFIG=config/sla_rules.json
DEDUPE_THRESHOLD=
RELATED_SIMILARITY_THRESHOLD=
RECURRING_SIMILARITY_THRESHOLD=
# Optional multilingual fastText model
FASTTEXT_MODEL_PATH=
# Optional institution-provided student-name list for explicit name redaction
STUDENT_NAMES_FILE=
# Optional LLM summarisation (routing remains deterministic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=20
# Set to 1 to force TF-IDF similarity fallback
DISABLE_SEMANTIC_DEDUP=0
# Required for admin mutations and protected admin APIs; use a long random secret.
ADMIN_TOKEN=
# Set a random secret for any deployment exposed beyond localhost.
SECRET_KEY=
# SQLite local default: leave DATABASE_URL empty.
# PostgreSQL pilot example (URL-encode special characters in credentials):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
FLASK_DEBUG=0
